{
    "name": "martin6363/filament-sidebar-resize",
    "description": "Drag-to-resize Filament v5 admin sidebar with localStorage persistence",
    "keywords": [
        "laravel",
        "filament",
        "plugin",
        "sidebar",
        "resize",
        "admin"
    ],
    "homepage": "https://github.com/martin6363/filament-sidebar-resize",
    "license": "MIT",
    "authors": [
        {
            "name": "Martin",
            "email": "martin.khachatryan.2024@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "filament/filament": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Martin6363\\SidebarResize\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Martin6363\\SidebarResize\\SidebarResizeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
